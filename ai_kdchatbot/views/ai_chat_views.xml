<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ai_chat_conversation_form" model="ir.ui.view">
        <field name="name">ai.chat.conversation.form</field>
        <field name="model">ai.chat.conversation</field>
        <field name="arch" type="xml">
            <form edit="false" create="false" duplicate="false" delete="false">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_id"/>
                    </group>

                    <field name="message_ids" create="false" delete="false">
                        <list create="false" delete="false">
                            <field name="role"/>
                            <field name="content"/>
                            <field name="create_date"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_chat_conversation_list" model="ir.ui.view">
        <field name="name">ai.chat.conversation.list</field>
        <field name="model">ai.chat.conversation</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="name"/>
                <field name="user_id"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>

    <record id="action_ai_chat_conversation" model="ir.actions.act_window">
        <field name="name">AI Conversations</field>
        <field name="res_model">ai.chat.conversation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ai_kdchatbot_root" name="AI KDChatbot" sequence="90" web_icon="ai_kdchatbot,static/description/icon.png"/>
    <menuitem id="menu_ai_chat_conversation" name="History"
              parent="menu_ai_kdchatbot_root"
              action="action_ai_chat_conversation"
              sequence="1"/>
    <menuitem id="menu_ai_chat_configuration" name="Configuration"
              parent="menu_ai_kdchatbot_root"
              sequence="2"/>
    <menuitem id="menu_ai_chat_setting" name="Settings"
              parent="menu_ai_chat_configuration"
              action="action_kd_bot_settings"
              sequence="1"/>

</odoo>
